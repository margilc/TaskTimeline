{
	"name": "TaskTimeline",
	"version": "2.3.0",
	"description": "Transform your task-based markdown files into an interactive, timeline-based board view",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"check": "tsc --noEmit",
		"test": "npm run check && jest"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"tasks",
		"timeline",
		"project-management"
	],
	"author": "Mario Gilcher",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/commands": "6.8.1",
		"@types/jest": "^29.5.14",
		"@types/node": "^16.11.6",
		"builtin-modules": "3.3.0",
		"chokidar": "^4.0.3",
		"esbuild": "^0.25.5",
		"jest": "^29.7.0",
		"obsidian": "latest",
		"ts-jest": "^29.2.5",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	}
}
